GOBY_DATABASE_URL=postgres://goby:replace-with-a-random-password@127.0.0.1:5432/goby?sslmode=disable
GOBY_LISTEN=:8096
# Maximum startup time, including database migrations; accepts 1s through 30m.
GOBY_STARTUP_TIMEOUT=5m
GOBY_PUBLIC_URL=https://goby.example.com
GOBY_SERVER_NAME=Goby
GOBY_SETUP_TOKEN=replace-with-a-random-secret-at-least-24-bytes
GOBY_COOKIE_SECURE=true
# Set only the actual reverse proxy CIDRs; omit for direct connections.
GOBY_TRUSTED_PROXIES=127.0.0.1/32,::1/128
GOBY_WEB_DIR=/usr/share/goby/admin
GOBY_FFMPEG=/opt/ffmpeg/9.0.1/bin/ffmpeg
GOBY_FFPROBE=/opt/ffmpeg/9.0.1/bin/ffprobe
# The service owns this dedicated cache. Do not point it at a media directory.
GOBY_TRANSCODING_ENABLED=true
GOBY_TRANSCODE_CACHE=/var/cache/goby/transcodes
GOBY_TRANSCODE_THREADS=2
GOBY_TRANSCODE_MAX_JOBS=2
GOBY_TRANSCODE_MAX_USER_JOBS=1
GOBY_TRANSCODE_MAX_SESSION_JOBS=1
GOBY_TRANSCODE_MAX_QUEUE_JOBS=16
GOBY_TRANSCODE_MAX_RETAINED_JOBS=128
# Decimal bytes: 20 GiB total, 8 GiB per job, and 512 MiB free-space reserve.
GOBY_TRANSCODE_MAX_CACHE_BYTES=21474836480
GOBY_TRANSCODE_MAX_JOB_BYTES=8589934592
GOBY_TRANSCODE_MIN_FREE_BYTES=536870912
GOBY_TRANSCODE_MAX_BITRATE=20000000
GOBY_TRANSCODE_MAX_WIDTH=1920
GOBY_TRANSCODE_MAX_HEIGHT=1080
GOBY_TRANSCODE_MAX_AUDIO_CHANNELS=8
# Decoding and encoding are independent. Hardware devices need Linux access.
# Decoder: software, vaapi, qsv, cuda. Encoder: software, vaapi, qsv, nvenc.
# VAAPI/QSV example: /dev/dri/renderD128. CUDA/NVENC example: 0.
GOBY_HW_DECODER=software
GOBY_HW_ENCODER=software
GOBY_HW_DEVICE=
# Colon-separated, administrator-approved directories on Linux.
GOBY_MEDIA_ROOTS=/media
# The database and this private master file must be backed up together.
GOBY_API_KEY_MASTER_KEY_FILE=/var/lib/goby/application-key-master.key
