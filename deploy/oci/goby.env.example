# Runtime configuration only. Never put this private file in the build context.
# Replace every placeholder before starting this installation.
GOBY_DATABASE_URL=postgres://goby:REPLACE_DB_PASSWORD@postgres.example.invalid:5432/goby?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
GOBY_PUBLIC_URL=https://goby.example.invalid
GOBY_SERVER_NAME=Goby
GOBY_SETUP_TOKEN=REPLACE_WITH_AN_INDEPENDENT_RANDOM_SECRET_AT_LEAST_24_BYTES
GOBY_COOKIE_SECURE=true
GOBY_STARTUP_TIMEOUT=5m
# Set the actual reverse-proxy CIDRs only; empty trusts no proxy headers.
GOBY_TRUSTED_PROXIES=
# Leave GOBY_WEB_DIR unset to select the embedded administrator bundle.
GOBY_MEDIA_ROOTS=/media
GOBY_TRANSCODING_ENABLED=true
GOBY_TRANSCODE_THREADS=2
GOBY_TRANSCODE_MAX_JOBS=2
GOBY_TRANSCODE_MAX_USER_JOBS=1
GOBY_TRANSCODE_MAX_SESSION_JOBS=1
GOBY_TRANSCODE_MAX_QUEUE_JOBS=16
GOBY_TRANSCODE_MAX_RETAINED_JOBS=128
GOBY_TRANSCODE_MAX_CACHE_BYTES=21474836480
GOBY_TRANSCODE_MAX_JOB_BYTES=8589934592
GOBY_TRANSCODE_MIN_FREE_BYTES=536870912
GOBY_TRANSCODE_MAX_BITRATE=20000000
GOBY_TRANSCODE_MAX_WIDTH=1920
GOBY_TRANSCODE_MAX_HEIGHT=1080
GOBY_TRANSCODE_MAX_AUDIO_CHANNELS=8
GOBY_HW_DECODER=software
GOBY_HW_ENCODER=software
GOBY_HW_DEVICE=
# The image supplies the pinned intro helper and its analysis configuration.
# Compose fixes this path; the analysis cache is persisted with the cache mount.
GOBY_MEDIA_ANALYSIS_FILE=/usr/share/goby/media-analysis.json
GOBY_RECOVERY_STATE_DIR=/var/lib/goby/recovery
GOBY_RECOVERY_OPERATIONS_DIR=/var/lib/goby/recovery-operations
GOBY_BACKUP_DIR=/var/lib/goby/backups
# Full restoration also needs a separately provisioned database and role.
# GOBY_RECOVERY_DATABASE_URL=postgres://goby_restore:REPLACE_RESTORE_PASSWORD@postgres.example.invalid:5432/goby_restore?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
GOBY_LOG_MAX_FILE_BYTES=4194304
GOBY_LOG_MAX_FILES=16
GOBY_LOG_RETENTION_DAYS=7
GOBY_LOG_MIN_FREE_BYTES=33554432
GOBY_ACTIVITY_RETENTION_DAYS=30
# Optional online providers; also enable Management.Metadata.EnableInternetProviders.
# See README.providers.md. MusicBrainz needs identification but no key.
# GOBY_ONLINE_PROVIDERS_ENABLED=false
# GOBY_MUSICBRAINZ_USER_AGENT=Goby/0.1 (https://github.com/moooyo/goby)
# Credentials are startup-only. Choose either VALUE or VALUE_FILE per setting.
# Keep real values private; never include them in build inputs or captured logs.
# _FILE paths require operator-supplied read-only mounts readable by UID 10001.
# GOBY_TMDB_TOKEN=REPLACE_WITH_PRIVATE_API_READ_ACCESS_TOKEN
# GOBY_TMDB_TOKEN_FILE=/run/secrets/tmdb-token
# GOBY_OPENSUBTITLES_API_KEY=REPLACE_WITH_PRIVATE_APPLICATION_API_KEY
# GOBY_OPENSUBTITLES_API_KEY_FILE=/run/secrets/opensubtitles-api-key
# Configure the OpenSubtitles username and password together.
# GOBY_OPENSUBTITLES_USERNAME=REPLACE_WITH_PRIVATE_ACCOUNT_USERNAME
# GOBY_OPENSUBTITLES_USERNAME_FILE=/run/secrets/opensubtitles-username
# GOBY_OPENSUBTITLES_PASSWORD=REPLACE_WITH_PRIVATE_ACCOUNT_PASSWORD
# GOBY_OPENSUBTITLES_PASSWORD_FILE=/run/secrets/opensubtitles-password
# GOBY_OPENSUBTITLES_USER_AGENT=Goby v0.1
# Subtitle downloads require the separately selected writable-media override.
# Ordinary metadata and image workflows retain the default read-only media bind.
