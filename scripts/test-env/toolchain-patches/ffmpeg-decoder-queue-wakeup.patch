+static void dec_waiter_set(SchDec *dec, int choked)
+{
+    waiter_set(&dec->waiter, choked);
+    // A choked decoder may have buffered packets in overflow while waiting
+    // for another packet on its input queue. Wake that receive explicitly so
+    // it can retry overflow even if its demuxer sends no more packets.
+    if (!choked)
+        tq_receive_interrupt(dec->queue);
+}
