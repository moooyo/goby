         struct pl_source_frame src = {
             .pts         = TS2T(in->pts, inlink->time_base),
             .duration    = TS2T(in->duration, inlink->time_base),
@@ -1660,6 +1900,8 @@ static const AVOption libplacebo_options[] = {
